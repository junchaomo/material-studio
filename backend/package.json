{
  "name": "@qmx/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.worker.local dist/backend/main.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cpu": "node ../scripts/start-cpu.mjs"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "undici": "8.12.3",
    "zod": "4.6.6"
  }
}
