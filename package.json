{
  "name": "qimingxing-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @qmx/backend && npm run build --workspace @qmx/frontend",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "npm run typecheck --workspace @qmx/backend && npm run typecheck --workspace @qmx/frontend",
    "frontend": "npm run dev --workspace @qmx/frontend",
    "backend": "npm run dev --workspace @qmx/backend",
    "cpu": "npm run cpu --workspace @qmx/backend",
    "admin": "node scripts/open-admin.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.5"
  }
}
